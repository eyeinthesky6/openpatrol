<?xml version="1.0"?>
<sdf version="1.10"><world name="openpatrol_warehouse">
  <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  <scene><ambient>.35 .35 .35 1</ambient><background>.08 .1 .12 1</background></scene>
  <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>.8 .8 .8 1</diffuse><direction>-.4 .2 -1</direction></light>
  <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>20 14 .1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 14 .1</size></box></geometry><material><diffuse>.18 .2 .22 1</diffuse></material></visual></link></model>
  <model name="shelf_a"><static>true</static><pose>2 1 .75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 .6 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 .6 1.5</size></box></geometry><material><diffuse>.45 .3 .16 1</diffuse></material></visual></link></model>
  <model name="shelf_b"><static>true</static><pose>2 -2 .75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 .6 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 .6 1.5</size></box></geometry><material><diffuse>.45 .3 .16 1</diffuse></material></visual></link></model>
  <include><uri>model://openpatrol</uri><pose>-3 0 0 0 0 0</pose></include>
</world></sdf>
